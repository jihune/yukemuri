# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/yukemuri-maintenance/
/.codex/
/outputs/
/work/

# Python collector cache; portable queue snapshots live in data/.
__pycache__/
*.pyc

# Owner-only exports and recovered databases.
/private/
/archives/raw/
*.jsonl.gz
*.sqlite
*.sqlite3
*.db
*.tsbuildinfo

# Source resources restored and checked by cloud-setup.sh.
/archives/git/app-pre-migration-20261009.bundle
/archives/git/runner-history-20261009.bundle
/data/crawl-checkpoint.json
/data/crawl-jobs.json
/docs/evidence/github-collector-migration-20261008.jpg
/lib/hotels.crawled.json
/public/images/city.jpg
/public/images/credits.json
/public/images/forest.jpg
/public/images/lake.jpg
/public/images/onsen.jpg
/public/images/ryokan.jpg
/public/images/snow.jpg
/scripts/crawler/fixtures/jalan-price-10.html
/scripts/crawler/fixtures/jalan-price-multi.html
